# Application Configuration
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql+asyncpg://kisanlink_user:kisanlink_secure_password@localhost:5432/kisanlink_db
SYNC_DATABASE_URL=postgresql+psycopg2://kisanlink_user:kisanlink_secure_password@localhost:5432/kisanlink_db

# Security & JWT (Phase 2 Preparation)
JWT_SECRET_KEY=local_insecure_dev_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Local demo only. Production environments always reject the demo OTP/bypass.
DEMO_AUTH_ENABLED=false

# Farmer voice listing extraction (server-side only; never expose in Vite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local binary CV inspection provider
# LOCAL_CV_MODEL_PATH=/absolute/path/to/best_freshness_model.pth
# LOCAL_CV_MODEL_CONFIG_PATH=/absolute/path/to/model_config.json
# LOCAL_CV_CLASS_NAMES_PATH=/absolute/path/to/class_names.json
# INSPECTION_UPLOAD_DIR=/absolute/path/to/uploads/freshness
INSPECTION_MAX_UPLOAD_BYTES=10485760
INSPECTION_MAX_IMAGE_PIXELS=40000000
# Ignored in production even when true; use object storage for production evidence.
SERVE_LOCAL_INSPECTION_UPLOADS=true
